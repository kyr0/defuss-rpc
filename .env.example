# Keys the demo servers, the benchmark and the Vite example read; copy to .env to override. No secrets here.
# Demo servers (examples/server-*.ts): listening port, 0 = any free port; unset = 63920, defuss-rpc's default.
PORT=63920
# scripts/serve.mjs (make start): port of the website.
SITE_PORT=4173
# examples/client.ts: the server it calls.
RPC_URL=http://127.0.0.1:63920
# Vite example build: the RPC endpoint baked into virtual:defuss-rpc when no `endpoint` option is set.
VITE_DEFUSS_RPC_URL=
# scripts/bench-server.ts: which server one bench process runs (set by scripts/bench.mjs).
PROVIDER=express
# scripts/bench.mjs: seconds per scenario, connections, autocannon worker threads, comma-separated server labels.
BENCH_DURATION=5
BENCH_CONNECTIONS=64
BENCH_WORKERS=4
BENCH_ONLY=
