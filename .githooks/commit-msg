#!/bin/sh
# Rejects commit messages that credit an AI assistant as co-author: this repository's history names human authors
# only. make setup activates the hook (git config core.hooksPath .githooks); .vae/checks/policy.py checks the history.
if grep -qiE '^co-authored-by:.*(claude|anthropic)' "$1"; then
	echo "commit-msg: remove the Co-Authored-By trailer for Claude/Anthropic; this repository credits human authors only" >&2
	exit 1
fi
